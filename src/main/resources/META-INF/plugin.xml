<idea-plugin>
    <id>org.taigaui.designtokens</id>
    <name>Taiga xUI Community</name>
    <vendor url="https://github.com/splincode">splincode</vendor>

    <!-- The description is generated from README.md by Gradle patchPluginXml. -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>JavaScript</depends>
    <depends>AngularJS</depends>
    <depends>com.intellij.css</depends>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <applicationConfigurable
            id="org.taigaui.designtokens.settings"
            parentId="tools"
            displayName="Taiga UI"
            instance="org.taigaui.designtokens.settings.TaigaDesignTokensConfigurable"
        />
        <polySymbols.webTypes
            source="web-types/event-plugins@3.1.0.web-types.json"
            enableByDefault="false"
        />
        <psi.referenceContributor
            language="CSS"
            implementation="org.taigaui.designtokens.navigation.DesignTokenReferenceContributor"
        />
        <psi.referenceContributor
            language="LESS"
            implementation="org.taigaui.designtokens.navigation.DesignTokenReferenceContributor"
        />
        <psi.referenceContributor
            language="SCSS"
            implementation="org.taigaui.designtokens.navigation.DesignTokenReferenceContributor"
        />
        <completion.contributor
            language="CSS"
            order="first"
            implementationClass="org.taigaui.designtokens.completion.DesignTokenCompletionContributor"
        />
        <completion.contributor
            language="LESS"
            order="first"
            implementationClass="org.taigaui.designtokens.completion.DesignTokenCompletionContributor"
        />
        <completion.contributor
            language="SCSS"
            order="first"
            implementationClass="org.taigaui.designtokens.completion.DesignTokenCompletionContributor"
        />
        <completion.contributor
            id="TaigaUIEventPluginHostCompletionContributor"
            language="TypeScript"
            order="first, before JSPatternBasedCompletionContributor, before JSCompletionContributor"
            implementationClass="org.taigaui.designtokens.events.TypeScriptHostEventPluginCompletionContributor"
        />
        <completion.contributor
            language="any"
            implementationClass="org.taigaui.designtokens.icons.IconCompletionContributor"
        />
        <localInspection
            shortName="UnknownTaigaUIDesignToken"
            displayName="Unknown Taiga UI design token"
            groupName="Taiga UI"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="org.taigaui.designtokens.completion.UnknownDesignTokenInspection"
        />
        <localInspection
            shortName="DeprecatedTaigaUIDesignToken"
            displayName="Deprecated Taiga UI design token"
            groupName="Taiga UI"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="org.taigaui.designtokens.completion.DeprecatedDesignTokenInspection"
        />
        <localInspection
            shortName="UnknownTaigaUIEventModifier"
            displayName="Unknown Taiga UI event modifier"
            groupName="Taiga UI"
            enabledByDefault="true"
            language="HtmlCompatible"
            level="ERROR"
            implementationClass="org.taigaui.designtokens.events.UnknownEventPluginModifierInspection"
        />
        <localInspection
            shortName="DuplicateTaigaUIEventModifier"
            displayName="Duplicate Taiga UI event modifier"
            groupName="Taiga UI"
            enabledByDefault="true"
            language="HtmlCompatible"
            level="ERROR"
            implementationClass="org.taigaui.designtokens.events.DuplicateEventPluginModifierInspection"
        />
        <localInspection
            shortName="InvalidTaigaUIEventModifierInHostBinding"
            displayName="Invalid Taiga UI event modifier in Angular host binding"
            groupName="Taiga UI"
            enabledByDefault="true"
            language="TypeScript"
            level="ERROR"
            implementationClass="org.taigaui.designtokens.events.TypeScriptEventPluginModifierInspection"
        />
        <lang.inspectionSuppressor
            language="TypeScript"
            implementationClass="org.taigaui.designtokens.events.TypeScriptHostEventPluginInspectionSuppressor"
        />
        <daemon.highlightInfoFilter
            implementation="org.taigaui.designtokens.events.EventPluginKeyEventHighlightInfoFilter"
        />
        <typedHandler
            implementation="org.taigaui.designtokens.icons.IconCompletionAutoPopupHandler"
            order="first, before completionAutoPopup"
        />
        <typedHandler
            implementation="org.taigaui.designtokens.completion.DesignTokenCompletionAutoPopupHandler"
        />
        <typedHandler
            implementation="org.taigaui.designtokens.events.TypeScriptHostEventPluginCompletionAutoPopupHandler"
            order="first, before completionAutoPopup"
        />
        <codeInsight.declarativeInlayProvider
            group="VALUES_GROUP"
            bundle="messages.TaigaDesignTokensBundle"
            implementationClass="org.taigaui.designtokens.units.RemInlayHintsProvider"
            isEnabledByDefault="true"
            language="CSS"
            nameKey="inlay.rem.px.name"
            descriptionKey="inlay.rem.px.description"
            providerId="taiga.rem.px.styles"
        />
        <codeInsight.declarativeInlayProvider
            group="VALUES_GROUP"
            bundle="messages.TaigaDesignTokensBundle"
            implementationClass="org.taigaui.designtokens.units.RemInlayHintsProvider"
            isEnabledByDefault="true"
            language="HTML"
            nameKey="inlay.rem.px.name"
            descriptionKey="inlay.rem.px.description"
            providerId="taiga.rem.px.templates"
        />
        <codeInsight.declarativeInlayProvider
            group="VALUES_GROUP"
            bundle="messages.TaigaDesignTokensBundle"
            implementationClass="org.taigaui.designtokens.units.RemInlayHintsProvider"
            isEnabledByDefault="true"
            language="JavaScript"
            nameKey="inlay.rem.px.name"
            descriptionKey="inlay.rem.px.description"
            providerId="taiga.rem.px.embedded.styles"
        />
        <editorFactoryMouseListener
            implementation="org.taigaui.designtokens.events.EventPluginsHoverPopupListener"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.events.EventPluginsHoverPopupListener"
        />
        <editorFactoryMouseListener
            implementation="org.taigaui.designtokens.documentation.DesignTokenHoverPopupListener"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.documentation.DesignTokenHoverPopupListener"
        />
        <editorFactoryMouseListener
            implementation="org.taigaui.designtokens.icons.IconHoverPopupListener"
        />
        <editorFactoryMouseMotionListener
            implementation="org.taigaui.designtokens.icons.IconHoverPopupListener"
        />
    </extensions>
    <actions>
        <action
            id="TaigaUI.BrowseIcons"
            class="org.taigaui.designtokens.icons.IconBrowserAction"
            text="Taiga UI: Browse Icons..."
            description="Browse, copy, and insert icons from the current project's Taiga UI catalog"
        >
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
